a media do atedimento


#include <stdio.h>
int main (){
	int n1;
	float media = 0.0;
	int soma;
	int i = 0;
	
	for (i=0; i<9; i++){
		printf ("digite a nota ao antedimento de: 0 a 10 %d \n", i);
		scanf ("%d", &n1);
		soma = n1 + soma;
		
	}
	media = soma / 10;
	printf ("a media do atendimento e: %.2f \n", media );
	if (media < 7){
		printf ("a media está abaixo do esperado!");
	}

}

